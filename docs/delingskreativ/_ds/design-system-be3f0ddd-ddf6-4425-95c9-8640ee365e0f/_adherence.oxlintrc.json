{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "deck-stage.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Parkinsans|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Parkinsans, Manrope."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--border-strong",
      "--border-subtle",
      "--font-body",
      "--font-display",
      "--leading-body",
      "--leading-heading",
      "--leading-tight",
      "--navy-green",
      "--navy-green-60",
      "--navy-green-80",
      "--ocean",
      "--ocean-40",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--shadow-card",
      "--shell",
      "--shell-dark",
      "--size-body",
      "--size-caption",
      "--size-display",
      "--size-h1",
      "--size-h2",
      "--size-h3",
      "--size-small",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--space-9",
      "--surface-accent",
      "--surface-card",
      "--surface-inverse",
      "--surface-muted",
      "--surface-page",
      "--text-body",
      "--text-heading",
      "--text-muted",
      "--text-on-accent",
      "--text-on-inverse",
      "--tracking-caption",
      "--tracking-display",
      "--weight-body",
      "--weight-body-strong",
      "--weight-display",
      "--white"
    ],
    "tokenKinds": {
      "--navy-green": "color",
      "--ocean": "color",
      "--shell": "color",
      "--white": "color",
      "--navy-green-80": "color",
      "--navy-green-60": "color",
      "--ocean-40": "color",
      "--shell-dark": "color",
      "--surface-page": "color",
      "--surface-inverse": "color",
      "--surface-card": "color",
      "--surface-muted": "color",
      "--surface-accent": "color",
      "--text-body": "font",
      "--text-muted": "font",
      "--text-on-inverse": "font",
      "--text-heading": "font",
      "--text-on-accent": "font",
      "--border-subtle": "color",
      "--border-strong": "color",
      "--accent": "color",
      "--font-display": "font",
      "--font-body": "font",
      "--weight-display": "font",
      "--weight-body": "font",
      "--weight-body-strong": "font",
      "--size-display": "spacing",
      "--size-h1": "spacing",
      "--size-h2": "spacing",
      "--size-h3": "spacing",
      "--size-body": "spacing",
      "--size-small": "spacing",
      "--size-caption": "spacing",
      "--leading-tight": "font",
      "--leading-heading": "font",
      "--leading-body": "font",
      "--tracking-display": "font",
      "--tracking-caption": "font",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
      "--space-6": "spacing",
      "--space-7": "spacing",
      "--space-8": "spacing",
      "--space-9": "spacing",
      "--radius-sm": "radius",
      "--radius-md": "radius",
      "--radius-lg": "radius",
      "--radius-pill": "radius",
      "--shadow-card": "shadow"
    },
    "fontFamilies": [
      "Manrope",
      "Parkinsans"
    ]
  }
}